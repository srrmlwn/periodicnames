{
  "framework": "vite",
  "devCommand": "vite",
  "buildCommand": "tsc -b && vite build",
  "rewrites": [
    {
      "source": "/:name((?!api$)[^/.]+)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Twitterbot|Slackbot|Discordbot|WhatsApp|TelegramBot|LinkedInBot|Pinterest|redditbot|Embedly|SkypeUriPreview|Iframely|Bluesky|Mastodon|vkShare|Snapchat).*"
        }
      ],
      "destination": "/api/name-page?name=:name"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/"
    }
  ],
  "crons": [
    { "path": "/api/printful/reconcile", "schedule": "17 16 * * *" }
  ],
  "functions": {
    "api/stripe/webhook.ts": {
      "maxDuration": 30
    },
    "api/printful/webhook.ts": {
      "maxDuration": 30
    },
    "api/printful/reconcile.ts": {
      "maxDuration": 60
    },
    "api/og.ts": {
      "includeFiles": "api/_lib/fonts/**"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        }
      ]
    }
  ]
}
